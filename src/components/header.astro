---
const isHome = Astro.url.pathname === '/';
---

<header class:list={['site-header', { 'site-header--home': isHome }]} id="site-header">
    <nav>
        <div class="site-brand">
            <a href="/" class="site-name">Nico Bonanno</a>
            {isHome && <span class="site-subtitle">Fotografo</span>}
        </div>

        <button
                type="button"
                class="nav-toggle"
                id="nav-toggle"
                aria-expanded="false"
                aria-controls="site-nav"
                aria-label="Apri il menu"
        >
            <span></span>
            <span></span>
            <span></span>
        </button>

        <ul id="site-nav">
            <li><a href="/about">Bio</a></li>
            <li><a href="/#categorie">Foto</a></li>
            <li><a href="/contatti">Contatti</a></li>
        </ul>
    </nav>
</header>

<script>
    const header = document.getElementById('site-header');
    const toggle = document.getElementById('nav-toggle');
    const nav = document.getElementById('site-nav');

    if (header && toggle && nav) {
        const closeMenu = () => {
            header.classList.remove('nav-open');
            toggle.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
        };

        const openMenu = () => {
            header.classList.add('nav-open');
            toggle.setAttribute('aria-expanded', 'true');
            document.body.style.overflow = 'hidden';
        };

        const toggleMenu = () => {
            if (header.classList.contains('nav-open')) {
                closeMenu();
            } else {
                openMenu();
            }
        };

        toggle.addEventListener('click', toggleMenu);

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') closeMenu();
        });

        nav.querySelectorAll('a').forEach((link) => {
            link.addEventListener('click', closeMenu);
        });
    }
</script>

{isHome && (
<script>
    const header = document.getElementById('site-header');

    if (header) {
        // 0 = in cima alla pagina, 1 = a metà dell'altezza scrollabile
        const update = () => {
            const scrollable = document.documentElement.scrollHeight - window.innerHeight;
            const target = scrollable * 0.5;
            const progress = target > 0 ? Math.min(window.scrollY / target, 1) : 1;
            header.style.setProperty('--shrink', progress.toFixed(3));
        };

        let ticking = false;
        const onScroll = () => {
            if (!ticking) {
                requestAnimationFrame(() => {
                    update();
                    ticking = false;
                });
                ticking = true;
            }
        };

        update();
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', update);
    }
</script>
    )}
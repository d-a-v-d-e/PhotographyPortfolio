---
import '../../styles/global.css';
import '../../styles/gallery.css';

import Gallery from '../../layouts/gallery.astro';
import { Picture } from 'astro:assets';
import NoRightClick from '../../components/no_right_click.astro';

// Importa automaticamente tutte le foto della cartella —
// aggiungerne una nuova qui dentro basta a farla comparire
// in galleria, senza toccare questo file.
const foto = Object.values(
    import.meta.glob<{ default: ImageMetadata }>(
        '../../assets/categorie/Kantiere/*.{jpg,jpeg,JPG,JPEG,png}',
        { eager: true }
    )
).map((mod) => mod.default);
---
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kantiere</title>
</head>

<NoRightClick />

<Gallery title="Kantiere">

    <Fragment slot="foto">
        <div class="descrizione">
            <a>Il Kantiere è un centro giovanile situato a Verbania, gestito da tante <br> realtà locali e che organizzano eventi e mettono a disposizione<br> spazi per realizzarli.<br><br>
                All'inizio del 2026 sono iniziati dei lavori di restauro, conclusi con una festa<br> di inaugurazione, tenutasi il 12 settembre 2026<br>
            </a>
        </div>
        {foto.map((img, i) => (

                <div class="foto_gallery">
                    <Picture
                            src={img}
                            alt={`Foto a colori ${i + 1}`}
                            height={800}
                            densities={[1, 1.5, 2]}
                            formats={['avif', 'webp', 'jpeg']}
                            loading={i < 2 ? 'eager' : 'lazy'}
                            quality={75}
                    />
                </div>
        ))}
    </Fragment>
</Gallery>
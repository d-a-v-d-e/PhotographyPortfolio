---
import Header from '../../components/header.astro';
import Footer from '../../components/footer.astro';
import NoRightClick from '../../components/no_right_click.astro';
import '../../styles/global.css';

const lang = 'it';
---



<html lang={lang}>
<NoRightClick />
<head>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nicola Bonanno</title>
    <link rel="icon" type="image/x-icon" href="../favicon.ico">
    <style>
        .home {
            background-image: url('/indexbgimg2.JPG');
            background-size: cover;
            background-repeat: no-repeat;

        }
    </style>
</head>
<body>

<section class="home">

    <Header />
    <div class="forward"><a href="#categorie"></a></div>
    <style> section .forward a::before{
        content: url(/icons8-freccia-espandi-52.png);
    }</style>
</section>
<div class="background-color"></div>
<section class="categorie" id="categorie">
    <div class="categorie-header">
        <div class="categorie-selector" id="categorie-selector">
            <button
                    type="button"
                    class="categorie-tab categorie-selector-button"
                    id="categorie-selector-button"
                    aria-expanded="false"
                    aria-haspopup="listbox"
            >
                <span id="categorie-selected">Foto</span>

                <svg
                        class="categorie-chevron"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                >
                    <path
                            d="M6 9l6 6 6-6"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                    />
                </svg>
            </button>

            <div
                    class="categorie-dropdown"
                    id="categorie-dropdown"
                    role="listbox"
                    aria-label="Seleziona categoria"
            >
                <button
                        type="button"
                        class="categorie-option"
                        data-category="foto"
                        role="option"
                        aria-selected="true"
                >
                    Foto
                </button>

                <button
                        type="button"
                        class="categorie-option"
                        data-category="eventi"
                        role="option"
                        aria-selected="false"

                >
                    Eventi e Commissioni
                </button>

            </div>
        </div>
    </div>

    <div class="categorie-panels categorie-content">
        <div class="content" id="foto-content" role="tabpanel" aria-labelledby="foto-tab">
            <a class="ca-next"></a>
            <a class="ca-prev"></a>

            <div class="card-categorie">
                <div class="image-primo-piano">
                    <a href="/it/f_colors"> <img src="/categorie/colors.jpg" alt="Foto a colori" width="400" height="500"></a>
                </div>
                <a href="">colori</a>
            </div>

            <div class="card-categorie">
                <div class="image-primo-piano">
                    <a href="/it/f_b&w"> <img src="/categorie/blackwhite.JPG" alt="Foto bianco e nero" width="400" height="500"></a>
                </div>
                <a href="">Bianco e nero</a>
            </div>

            <div class="card-categorie">
                <div class="image-primo-piano">
                    <a href="/it/f_concepts"> <img src="/categorie/concepts.jpg" alt="Foto Concept" width="400" height="500"></a>
                </div>
                <a href="">Concepts</a>
            </div>

            <div class="card-categorie">
                <div class="image-primo-piano">
                    <a href="/it/f_edited"> <img src="/categorie/edited.jpg" alt="boh" width="400" height="500"></a>
                </div>
                <a href="">?</a>
            </div>
        </div>

        <div
                class="ev-content categorie-content"
                id="eventi-content"
                role="tabpanel"
                aria-labelledby="eventi-tab"
                style="display: none;"
        >
            <div class="card-categorie">
                <div class="image-primo-piano">
                    <a href="/it/f_scotch"> <img src="/categorie/scotch.jpg" alt="Foto Scotch" width="400" height="500"></a>
                </div>
                <a href="">Scotch</a>
            </div>

            <div class="card-categorie">
                <div class="image-primo-piano">
                    <a href="/it/f_kantiere"> <img src="/categorie/kantiere.jpg" alt="Foto Kantiere" width="400" height="500"></a>
                </div>
                <a href="">Kantiere</a>
            </div>
        </div>
    </div>
</section>
<Footer />
</body>
</html>

<script>
    const selector = document.getElementById('categorie-selector');
    const selectorButton = document.getElementById('categorie-selector-button');
    const selectedLabel = document.getElementById('categorie-selected');
    const dropdown = document.getElementById('categorie-dropdown');

    const panels = document.querySelectorAll<HTMLElement>('.categorie-content');
    const options = document.querySelectorAll<HTMLButtonElement>('.categorie-option');

    type Category = {
        label: string;
        content: HTMLElement;
    };

    type CategoryId = 'foto' | 'eventi';

    const categories: Record<CategoryId, Category> = {
        foto: {
            label: 'Foto',
            content: document.getElementById('foto-content') as HTMLElement
        },
        eventi: {
            label: 'Eventi e Commissioni',
            content: document.getElementById('eventi-content') as HTMLElement
        }
    };

    let current: CategoryId = 'foto';
    let animating = false;

    if (
        selector &&
        selectorButton &&
        selectedLabel &&
        dropdown
    ) {
        const closeDropdown = () => {
            selector.classList.remove('is-open');
            selectorButton.setAttribute('aria-expanded', 'false');
        };

        const openDropdown = () => {
            selector.classList.add('is-open');
            selectorButton.setAttribute('aria-expanded', 'true');
        };

        const swap = (
            hide: HTMLElement,
            show: HTMLElement,
            hideClass: string,
            showClass: string
        ): void => {
            animating = true;

            hide.classList.add(hideClass);

            setTimeout(() => {
                hide.style.display = 'none';
                hide.classList.remove(hideClass);

                show.style.display = 'grid';
                show.classList.add(showClass);

                requestAnimationFrame(() => {
                    requestAnimationFrame(() => {
                        show.classList.remove(showClass);
                        animating = false;
                    });
                });
            }, 350);
        };

        const selectCategory = (category: CategoryId): void => {
            if (animating) return;

            const selectedCategory = categories[category];
            const currentCategory = categories[current];

            if (!selectedCategory) return;

            /*
             * Chiude SEMPRE il dropdown quando viene
             * selezionata una voce.
             */
            closeDropdown();

            if (category === current) {
                return;
            }

            current = category;

            selectedLabel.textContent = selectedCategory.label;

            options.forEach((option: HTMLButtonElement) => {
                const isSelected =
                    option.dataset.category === category;

                option.setAttribute(
                    'aria-selected',
                    String(isSelected)
                );
            });

            if (category === 'eventi') {
                swap(
                    currentCategory.content,
                    selectedCategory.content,
                    'slide-out-left',
                    'slide-in-right'
                );
            } else {
                swap(
                    currentCategory.content,
                    selectedCategory.content,
                    'slide-out-right',
                    'slide-in-left'
                );
            }
        };

        /* =========================
           APERTURA / CHIUSURA DROPDOWN
           ========================= */

        selectorButton.addEventListener('click', (event) => {
            event.stopPropagation();

            if (selector.classList.contains('is-open')) {
                closeDropdown();
            } else {
                openDropdown();
            }
        });

        /* =========================
           SELEZIONE CATEGORIA
           ========================= */

        options.forEach((option: HTMLButtonElement) => {
            option.addEventListener('click', (event) => {
                event.stopPropagation();

                const category =
                    option.dataset.category as CategoryId;

                if (category) {
                    selectCategory(category);
                }
            });
        });

        /* =========================
           CLICK FUORI
           ========================= */

        document.addEventListener('click', (event: MouseEvent) => {
            const target = event.target;

            if (
                target instanceof Node &&
                !selector.contains(target)
            ) {
                closeDropdown();
            }
        });

        /* =========================
           ESC
           ========================= */

        document.addEventListener('keydown', (event: KeyboardEvent) => {
            if (event.key === 'Escape') {
                closeDropdown();
            }
        });


    }
</script>
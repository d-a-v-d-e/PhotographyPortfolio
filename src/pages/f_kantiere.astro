---
import '../styles/global.css';
import '../styles/gallery.css';

import Gallery from '../layouts/gallery.astro';
import { Picture } from 'astro:assets';
import NoRightClick from '../components/no_right_click.astro';


const moduliFoto = import.meta.glob<{ default: ImageMetadata }>(
    '../assets/categorie/Kantiere/*.{jpg,jpeg,JPG,JPEG,png,webp}',
    { eager: true }
);

const foto = Object.entries(moduliFoto)
    .sort(([a], [b]) => {
        const nomeA = a.split('/').pop()!;
        const nomeB = b.split('/').pop()!;

        return nomeA.localeCompare(nomeB, undefined, {
            numeric: true,
            sensitivity: 'base'
        });
    });
---
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Riapertura del Kantiere</title>
</head>

<NoRightClick />

<Gallery title="Riapertura del Kantiere">

    <Fragment slot="foto">
        <div class="descrizione">
            <a class="specifica">2026 • EVENTO</a>
            <div class="visual">

            <a>Il Kantiere è un centro giovanile situato a Verbania, gestito da tante realtà locali e che organizzano eventi e mettono a disposizione spazi per realizzarli.<br><br>
                All'inizio del 2026 sono iniziati dei lavori di restauro, conclusi con una festa di inaugurazione, tenutasi il 12 settembre 2026<br>

            </a>
            </div>
        </div>
        {foto.map(([path, mod], i) => (
                <div class="foto_gallery" style="position: relative;">

                    <div class="image-placeholder"></div>

                    <Picture
                            src={mod.default}
                            alt={`Kantiere ${i + 1}`}
                            height={800}
                            densities={[1, 1.5, 2]}
                            formats={['avif', 'webp', 'jpeg', 'webp']}
                            loading={i < 2 ? 'eager' : 'lazy'}
                            quality={100}
                    />
                </div>
        ))}
    </Fragment>
</Gallery>
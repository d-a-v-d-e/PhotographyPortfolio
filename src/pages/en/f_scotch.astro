---
import '../../styles/global.css';
import '../../styles/gallery.css';

import Gallery from '../../layouts/gallery.astro';
import { Picture } from 'astro:assets';
import NoRightClick from '../../components/no_right_click.astro';


const moduliFoto = import.meta.glob<{ default: ImageMetadata }>(
    '../../assets/categorie/Scotch/*.{jpg,jpeg,JPG,JPEG,png,webp}',
    { eager: true }
);

const foto = Object.entries(moduliFoto)
    .sort(([a], [b]) => {
        const nomeA = a.split('/').pop()!;
        const nomeB = b.split('/').pop()!;

        return nomeA.localeCompare(nomeB, undefined, {
            numeric: true,
            sensitivity: 'base'
        });
    });
---
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Scotch</title>
</head>

<NoRightClick />
<Gallery title="Scotch">
    <Fragment slot="foto">
        <div class="descrizione">
            <a class="specifica">2026 • COMMISSION</a>
            <div class="visual">
                <a>
                    Scotch is a festival held periodically at Fadabrav, a social woodworking workshop located in the Sant'Agabio neighbourhood of Novara.<br><br>
                    The first edition took place in 2023. This year, the space came to life with talks, live music, games, and hands-on activities.
                </a>
            </div>
        </div>
        {foto.map(([path, mod], i) => (
                <div class="foto_gallery" style="position: relative;">

                    <div class="image-placeholder"></div>

                    <Picture
                            src={mod.default}
                            alt={`Scotch ${i + 1}`}
                            height={800}
                            densities={[1, 1.5, 2]}
                            formats={['avif', 'webp', 'jpeg']}
                            loading={i < 2 ? 'eager' : 'lazy'}
                            quality={100}
                    />

                </div>

        ))}
    </Fragment>
</Gallery>

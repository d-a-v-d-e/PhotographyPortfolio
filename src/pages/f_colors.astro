---
import '../styles/global.css';
import '../styles/gallery.css';

import Gallery from '../layouts/gallery.astro';
import { Picture } from 'astro:assets';
import NoRightClick from '../components/no_right_click.astro';

// Importa automaticamente tutte le foto della cartella —
// aggiungerne una nuova qui dentro basta a farla comparire
// in galleria, senza toccare questo file.
const foto = Object.values(
    import.meta.glob<{ default: ImageMetadata }>(
        '../assets/categorie/Foto-colorate/*.{jpg,jpeg,JPG,JPEG,png}',
        { eager: true }
    )
).map((mod) => mod.default);
---
<NoRightClick />
<Gallery title="Colori">
    <Fragment slot="foto">
        {foto.map((img, i) => (
                <div class="foto_gallery">
                    <Picture
                            src={img}
                            alt={`Foto a colori ${i + 1}`}
                            height={800}
                            densities={[1, 1.5, 2]}
                            formats={['avif', 'webp', 'jpeg']}
                            loading={i < 2 ? 'eager' : 'lazy'}
                            quality={75}
                    />
                </div>
        ))}
    </Fragment>
</Gallery>
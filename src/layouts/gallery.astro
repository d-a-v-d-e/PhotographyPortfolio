---
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";

interface Props {
	title: string;
}
const{title} = Astro.props
---

<html lang="it">
    <head>
        <title>{title}</title>
    </head>
    <body>
        <Header />
        <h1>{title}</h1>
        <div class="ph_content">
            <a class="ca-next"></a>
            <a class="ca-prev"></a>
            <slot name="foto" />

            <slot />
        </div>
        <Footer />
    </body>
</html>